generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. DEFINICIÓN DE ROLES
enum Role {
  SUPERADMIN  // <--- NUEVO: El único que puede crear otros admins
  ADMIN       // <--- Gestiona jóvenes y asistencias
  LIDER       // <--- Solo toma asistencia (Kiosco)
  REGISTRO    
}

// 2. MODELO DE USUARIO 
model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  nombre   String
  role     Role    @default(LIDER) 
  sede     String?
}

// --- GESTIÓN DE ÁREAS Y ACTIVIDADES ---

model Area {
  id          Int      @id @default(autoincrement())
  title       String       
  description String?
  img         String?
  value       String       @unique 
  rol         String
  
  activities  Activities[] 
}

model Activities {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  img         String?
  place       String
  hour_start  DateTime
  hour_end    DateTime
  urgent      Boolean  @default(false)

  areaId      Int?
  area        Area?    @relation(fields: [areaId], references: [id])
}

// --- CONTENIDO WEB ---

model Preachs {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  img         String?
  urlVideo    String? 
}

model LastActivities {
  id    Int     @id @default(autoincrement())
  title String
  img   String?
}

// --- GESTIÓN DE JÓVENES ---

model Joven {
  id              Int          @id @default(autoincrement())
  nombres         String
  apellidos       String
  documento       String       @unique
  telefono        String?      
  fechaNacimiento DateTime?
  sede            String
  
  ultimaVisita    DateTime?     @default(now())
  activo          Boolean      @default(true)
  
  asistencias     Asistencia[]
}

model Asistencia {
  id      Int      @id @default(autoincrement())
  fecha   DateTime @default(now())
  
  jovenId Int
  joven   Joven    @relation(fields: [jovenId], references: [id], onDelete: Cascade)
}

// --- NUEVO: GESTIÓN DE EQUIPO (Para que funcione el login seguro) ---
model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("LIDER") 
  createdAt DateTime @default(now())
}