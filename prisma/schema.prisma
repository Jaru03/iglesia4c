generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

//
// ================= ENUMS =================
//

enum Role {
  ADMIN
  USER
  RESPONSIBLE
  LEADER
  OBRERO
}

enum MembershipStatus {
  VISITOR
  ACTIVE
  INACTIVE
}

enum LifeStage {
  KID
  TEEN
  YOUNG
  ADULT
  SENIOR
}

//
// ================= CHURCH =================
//

model Church {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  place       String
  latitude    Float
  longitude   Float
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules    ChurchSchedule[]
  pastors      ChurchPastor[]
  socialLinks  ChurchSocialLink[]
  persons      Person[]
  departments  Department[]
  leaders      ChurchLeader[]
  appointments Appointment[]
  activities   Activity[]
}

model ChurchSchedule {
  id   Int    @id @default(autoincrement())
  day  String
  time String
  name String @default("")

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])
}

model ChurchPastor {
  id    Int     @id @default(autoincrement())
  name  String
  image String?

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])
}

model ChurchSocialLink {
  id    Int     @id @default(autoincrement())
  name  String
  url   String
  icon  String?
  value String?

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])
}

model ChurchLeader {
  id           Int           @id @default(autoincrement())
  role         Role
  order        Int           @default(0)

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@unique([churchId, userId])
}

//
// ================= PERSON =================
//

model Person {
  id               Int              @id @default(autoincrement())
  name             String
  lastname         String
  email            String?          @unique
  phone            String?
  document         String?          @unique
  birthDate        DateTime?
  lifeStage        LifeStage?
  address          String?
  membershipStatus   MembershipStatus @default(VISITOR)
  active             Boolean          @default(true)

  // Campos de registro de visitantes (Atención Primaria)
  arrivedAt          DateTime?
  attendsChurch      Boolean?
  howDidYouMeetUs    String?
  authorizedContact  Boolean          @default(false)
  prayerRequest      String?
  signature          String?          // URL pública en Supabase Storage (bucket: signatures)

  isMember Boolean @default(false)

  churchId Int?
  church   Church? @relation(fields: [churchId], references: [id])

  user        User?
  attendances Attendance[]
  departments PersonDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, active, membershipStatus])
  @@index([active, createdAt])
}

//
// ================= USER =================
//

model User {
  id       Int    @id @default(autoincrement())
  password String
  role     Role   @default(USER)

  createdAt DateTime @default(now())

  personId Int    @unique
  person   Person @relation(fields: [personId], references: [id])

  departmentMemberships DepartmentMember[]
  churchLeaderRoles     ChurchLeader[]
  availability          Availability[]
  appointmentsAsHost    Appointment[]      @relation("ResponsableAppointments")
  appointmentsAsUser    Appointment[]      @relation("UserAppointments")
  memberAvailabilities  MemberAvailability[]    @relation("UserMemberAvailability")
  unavailableDates      MemberUnavailableDate[] @relation("UserUnavailableDates")
  calendarEntries       CalendarEntry[]         @relation("UserCalendarEntry")
}

//
// ================= DEPARTMENT =================
//

model Department {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  active      Boolean @default(true)

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])

  members    DepartmentMember[]
  persons    PersonDepartment[]
  activities Activity[]
  teamCalendars TeamCalendar[]
  cargos     DepartmentCargo[]

  createdAt DateTime @default(now())
}

//
// ================= DEPARTMENT MEMBER =================
//

model DepartmentMember {
  id Int @id @default(autoincrement())

  userId       Int
  departmentId Int

  roleInDept Role?
  joinedAt   DateTime @default(now())
  active     Boolean  @default(true)

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
  @@index([userId, roleInDept, active])
  @@index([departmentId, active])
}

//
// ================= PERSON DEPARTMENT =================
//

model PersonDepartment {
  id Int @id @default(autoincrement())

  personId     Int
  departmentId Int

  roleInDept Role?
  joinedAt   DateTime @default(now())
  active     Boolean  @default(true)

  person     Person     @relation(fields: [personId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([personId, departmentId])
  @@index([departmentId, active])
}

//
// ================= ACTIVITY =================
//

model Activity {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  place        String
  img          String?
  date         DateTime
  hourStart    DateTime
  hourEnd      DateTime
  showCalendar         Boolean  @default(true)
  isCulto              Boolean  @default(false)
  allowPreRegistration Boolean  @default(false)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  churchId Int?
  church   Church? @relation(fields: [churchId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())

  @@index([hourStart])
  @@index([departmentId, isCulto, hourStart])
  @@index([churchId, isCulto, hourStart])
  @@index([departmentId, showCalendar])
}

//
// ================= ATTENDANCE =================
//

model Attendance {
  id            Int     @id @default(autoincrement())
  attended      Boolean @default(false)
  preRegistered Boolean @default(false)
  autoMarked    Boolean @default(false)

  personId   Int
  activityId Int

  person   Person   @relation(fields: [personId], references: [id])
  activity Activity @relation(fields: [activityId], references: [id])

  @@unique([personId, activityId])
  @@index([activityId, attended])
  @@index([personId])
}

//
// ================= PETITION =================
//

model Petition {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String
  phone        String
  typePetition String
  content      String
  status       String   @default("PENDIENTE")
  createdAt    DateTime @default(now())
}

//
// ================= APPOINTMENTS =================
//

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Availability {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  dayOfWeek    Int      // 0=Dom, 1=Lun, 2=Mar, 3=Mie, 4=Jue, 5=Vie, 6=Sab
  slotIndex    Int      @default(0) // 0=primera franja, 1=segunda franja
  startTime    String   // "09:00"
  endTime      String   // "17:00"
  slotDuration Int      @default(30) // minutos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOfWeek, slotIndex])
}

model Appointment {
  id            Int               @id @default(autoincrement())
  responsableId Int
  responsable   User              @relation("ResponsableAppointments", fields: [responsableId], references: [id])
  userId        Int
  user          User              @relation("UserAppointments", fields: [userId], references: [id])
  churchId      Int
  church        Church            @relation(fields: [churchId], references: [id])
  date          DateTime
  startTime     String            // "10:00"
  endTime       String            // "10:30"
  status        AppointmentStatus @default(PENDING)
  notes         String?
  reminderSent  Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ================= TEAM CALENDAR =================
//

model MemberAvailability {
  id        Int      @id @default(autoincrement())
  userId    Int
  dayOfWeek Int      // 0=Dom...6=Sáb
  user      User     @relation("UserMemberAvailability", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, dayOfWeek])
}

model MemberUnavailableDate {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime // fecha UTC exacta en que no puede
  user      User     @relation("UserUnavailableDates", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model DepartmentCargo {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([departmentId, name])
}

model TeamCalendar {
  id           Int             @id @default(autoincrement())
  departmentId Int
  month        Int             // 1-12
  year         Int
  department   Department      @relation(fields: [departmentId], references: [id])
  entries      CalendarEntry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([departmentId, month, year])
}

model CalendarEntry {
  id         Int          @id @default(autoincrement())
  calendarId Int
  date       DateTime
  userId     Int?
  task       String?
  notes      String?
  calendar   TeamCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user       User?        @relation("UserCalendarEntry", fields: [userId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([calendarId, date])
  @@index([userId, date])
}
