generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. DEFINICIÓN DE ROLES
enum Role {
  SUPERADMIN  
  ADMIN       
  LIDER       
  REGISTRO    
}

// 2. MODELO DE USUARIO 
model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  nombre   String
  role     Role    @default(LIDER) 
  sede     String?
}

// --- GESTIÓN DE ÁREAS Y ACTIVIDADES ---

model Area {
  id          Int      @id @default(autoincrement())
  title       String       
  description String?
  img         String?
  value       String       @unique 
  rol         String
  
  activities  Activities[] 
}

model Activities {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  img         String?
  place       String
  hour_start  DateTime
  hour_end    DateTime
  urgent      Boolean  @default(false)

  areaId      Int?
  area        Area?    @relation(fields: [areaId], references: [id])
}

// --- CONTENIDO WEB ---

model Preachs {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  img         String?
  urlVideo    String? 
}

model LastActivities {
  id    Int     @id @default(autoincrement())
  title String
  img   String?
}

// --- GESTIÓN DE JÓVENES ---

model Joven {
  id              Int          @id @default(autoincrement())
  nombres         String
  apellidos       String
  documento       String       @unique
  telefono        String?      
  fechaNacimiento DateTime?
  sede            String
  grupoId         Int?     
  grupo           Grupo?    @relation(fields: [grupoId], references: [id])
  ultimaVisita    DateTime?     @default(now())
  activo          Boolean      @default(true)
  asistencias     Asistencia[]
}

model Asistencia {
  id      Int      @id @default(autoincrement())
  fecha   DateTime @default(now())
  
  jovenId Int
  joven   Joven    @relation(fields: [jovenId], references: [id], onDelete: Cascade)
}

// --- NUEVO: GESTIÓN DE EQUIPO ---
model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("LIDER") 
  createdAt DateTime @default(now())
}
// --- ZONA DE UJIERES Y REGISTRO ---

model Persona {
  id          String     @id @default(cuid())
  nombre      String
  telefono    String?   
  FechaNacimiento DateTime?
  esNuevo     Boolean    @default(true)
  esJoven     Boolean    @default(false)
  fechaVisita DateTime   @default(now())
  estado          String     @default("NUEVO") 
  conteoVisitas   Int        @default(1)       
  jovenId         Int?
  peticiones  Peticion[] 
}

model Peticion {
  id          String   @id @default(cuid())
  motivo      String  
  estado      EstadoPeticion @default(PENDIENTE)
  fecha       DateTime @default(now())
  personaId   String?
  persona     Persona? @relation(fields: [personaId], references: [id])
}

enum EstadoPeticion {
  PENDIENTE
  ORANDO
  RESPONDIDA
}
// --- GRUPOS DE CONEXIÓN / CÉLULAS ---
model Grupo {
  id          Int      @id @default(autoincrement())
  nombre      String   
  lider       String   
  dia         String   
  hora        String   
  direccion   String   
  tipo        String   
  activo      Boolean  @default(true)
  miembros    Joven[]  
}

model AuditLog {
  id          String   @id @default(cuid())
  module      String
  action      String
  entity      String
  entityId    String?
  description String?
  actorEmail  String?  @default("sistema")
  createdAt   DateTime @default(now())
}
