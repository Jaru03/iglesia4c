generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

//
// ================= ENUMS =================
//

enum Role {
  ADMIN // Control global del sistema
  MEMBER // Usuario que puede servir y editar dentro de su departamento
  USER // Usuario con acceso básico
}

enum MembershipStatus {
  VISITOR
  MEMBER
  INACTIVE
}

enum LifeStage {
  KID
  TEEN
  YOUNG
  ADULT
  SENIOR
}

//
// ================= CHURCH =================
//

model Church {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  place       String
  latitude    Float
  longitude   Float
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules   ChurchSchedule[]
  pastors     ChurchPastor[]
  socialLinks ChurchSocialLink[]
  persons     Person[]
  departments Department[]
}

model ChurchSchedule {
  id   Int    @id @default(autoincrement())
  day  String
  time String

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])
}

model ChurchPastor {
  id    Int     @id @default(autoincrement())
  name  String
  image String?

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])
}

model ChurchSocialLink {
  id    Int     @id @default(autoincrement())
  name  String
  url   String
  icon  String?
  value String?

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])
}

//
// ================= PERSON =================
//

model Person {
  id               Int              @id @default(autoincrement())
  name             String
  lastname         String
  email            String?          @unique
  phone            String?
  document         String?          @unique
  birthDate        DateTime?
  lifeStage        LifeStage?
  address          String?
  membershipStatus MembershipStatus @default(VISITOR)
  active           Boolean          @default(true)

  churchId Int?
  church   Church? @relation(fields: [churchId], references: [id])

  user        User?
  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ================= USER =================
//

model User {
  id       Int    @id @default(autoincrement())
  password String
  role     Role   @default(USER)

  createdAt DateTime @default(now())

  personId Int    @unique
  person   Person @relation(fields: [personId], references: [id])

  departmentMemberships DepartmentMember[]
}

//
// ================= DEPARTMENT =================
//

model Department {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  active      Boolean @default(true)

  churchId Int
  church   Church @relation(fields: [churchId], references: [id])

  members    DepartmentMember[]
  activities Activity[]

  createdAt DateTime @default(now())
}

//
// ================= DEPARTMENT MEMBER =================
//

model DepartmentMember {
  id Int @id @default(autoincrement())

  userId       Int
  departmentId Int

  roleInDept String? // Ej: Líder, Servidor, Coordinador
  joinedAt   DateTime @default(now())
  active     Boolean  @default(true)

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
}

//
// ================= ACTIVITY =================
//

model Activity {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  place        String
  img          String?
  date         DateTime
  hourStart    DateTime
  hourEnd      DateTime
  showCalendar Boolean  @default(true)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())
}

//
// ================= ATTENDANCE =================
//

model Attendance {
  id       Int     @id @default(autoincrement())
  attended Boolean @default(false)

  personId   Int
  activityId Int

  person   Person   @relation(fields: [personId], references: [id])
  activity Activity @relation(fields: [activityId], references: [id])

  @@unique([personId, activityId])
}
